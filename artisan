#!/usr/bin/env php
<?php

/**
 * Punto de entrada de Artisan CLI.
 *
 * Inicializa Laravel desde la línea de comandos para ejecutar
 * comandos como migrate, queue:listen, test, etc.
 */

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Registrar el autoloader de Composer
require __DIR__ . '/vendor/autoload.php';

// Inicializar Laravel y ejecutar el comando
/** @var Application $app */
$app = require_once __DIR__ . '/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
